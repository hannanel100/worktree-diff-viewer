{
  "name": "worktree-diff-viewer",
  "version": "0.2.0",
  "description": "Local web UI that lists every worktree of a git repository and shows what each worktree's branch changed against a base branch of your choice.",
  "type": "module",
  "bin": {
    "wtdiff": "./bin/wtdiff.js"
  },
  "files": [
    "bin",
    "app",
    "components",
    "lib",
    ".next",
    "!.next/cache",
    "next.config.ts",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node bin/wtdiff.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "git",
    "worktree",
    "diff",
    "review",
    "cli",
    "nextjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "diff2html": "^3.4.56",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
