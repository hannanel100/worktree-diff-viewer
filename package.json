{
  "name": "@hannanel100/worktree-diff-viewer",
  "version": "0.3.0",
  "description": "Local web UI that lists every worktree of a git repository and shows what each worktree's branch changed against a base branch of your choice.",
  "type": "module",
  "bin": {
    "wtdiff": "./bin/wtdiff.js"
  },
  "files": [
    "bin",
    "dist",
    "out",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:web && npm run build:server",
    "build:web": "next build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node bin/wtdiff.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "git",
    "worktree",
    "diff",
    "review",
    "cli"
  ],
  "license": "MIT",
  "author": "hannanel100",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "diff2html": "^3.4.56",
    "esbuild": "^0.28.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
